<?xml version="1.0" encoding="UTF-8"?>
<!-- 
     PreparedStatment
     ResultSet
     SQL => VO
 -->
<!DOCTYPE mapper
 PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
 "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
 <mapper namespace="com.sist.dao.music-mapper">
     <!-- namespace : package
          id = SQL문장의 구분자 => 중복 불가
          resultType : VO 지정
            ex) 
                SELECT pwd FROM member => resultType="String"
                SELECT COUNT(*) FROM member => resultType="int"
                SELECT no, cno, poster, title, singer FROM member => resultType="MemberVO"  => 변수가 2개 이상 => VO
                
          parameterType : ?에 값 지정
            ex)
                INSERT INTO member VALUES(?,?,?,?,?,?)
                                          ===========
                                           MemberVO
                SELECT * FROM music
                WHERE ? LIKE '%?%'   ==> Map
                      title
                      singer
                      album               
                
      -->
     <select id="musicListData" resultType="MusicVO" parameterType="int">
        SELECT no, cno, poster, title, singer 
    	FROM genie_music 
    	WHERE cno = #{cno}
    	ORDER BY no
     </select>
 </mapper>